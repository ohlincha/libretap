{
 "format": "libretap-protocol",
 "version": 1,
 "name": "Anton Paar Cora 5000 (BaySpec spectrometers, I/O board, laser driver, MCP2200)",
 "notes": "From USB captures of the vendor software, 2026-11-20 (LibreRaman's PROTOCOL.md). Devices behind the instrument's own hub: BaySpec ba8c:1688 (two), Prolific 067b:2303 = I/O board (115200 8N1, LF, \"OK\"), Silicon Labs 10c4:ea60 = laser driver (19200 8N1, CR), Microchip 04d8:00df = MCP2200 GPIO over HID. SAFETY: IO L 09 switches the 532 nm laser on (when armed); laseron/current drive the 1064 nm laser. Verified on the instrument: exposure units, laser line 09, arming bits. Guessed: the roles of the other I/O lines, param2.",
 "messages": [
  {
   "name": "BaySpec: read EEPROM",
   "usb": {
    "bmRequestType": "0xC0",
    "bRequest": "0xA1"
   },
   "say": "Spectrometer: read 64 bytes of its EEPROM at offset {block}",
   "device": "ba8c:1688",
   "fields": [
    {
     "name": "block",
     "from": "wIndex",
     "format": "hex"
    }
   ]
  },
  {
   "name": "BaySpec: reset",
   "usb": {
    "bmRequestType": "0x40",
    "bRequest": "0xA3"
   },
   "say": "Spectrometer: reset / initialise",
   "device": "ba8c:1688"
  },
  {
   "name": "BaySpec: set flag",
   "usb": {
    "bmRequestType": "0x40",
    "bRequest": "0xA4"
   },
   "say": "Spectrometer: set flag 0x3F0 to {value} (0 on spectrometer #1, 1 on #2)",
   "device": "ba8c:1688",
   "fields": [
    {
     "name": "value",
     "from": "wValue"
    }
   ]
  },
  {
   "name": "BaySpec: read flag",
   "usb": {
    "bmRequestType": "0xC0",
    "bRequest": "0xA4"
   },
   "say": "Spectrometer: read flag {index}",
   "device": "ba8c:1688",
   "fields": [
    {
     "name": "index",
     "from": "wIndex",
     "format": "hex"
    }
   ]
  },
  {
   "name": "BaySpec: read 0xA8",
   "usb": {
    "bmRequestType": "0xC0",
    "bRequest": "0xA8"
   },
   "say": "Spectrometer: read 0xA8 at {index} (stalls on #1; perhaps a temperature)",
   "device": "ba8c:1688",
   "fields": [
    {
     "name": "index",
     "from": "wIndex",
     "format": "hex"
    }
   ]
  },
  {
   "name": "BaySpec: 0xAD",
   "usb": {
    "bmRequestType": "0x40",
    "bRequest": "0xAD"
   },
   "say": "Spectrometer #2: command 0xAD at {index}",
   "device": "ba8c:1688",
   "fields": [
    {
     "name": "index",
     "from": "wIndex",
     "format": "hex"
    }
   ]
  },
  {
   "name": "BaySpec: set exposure",
   "usb": {
    "bmRequestType": "0x40",
    "bRequest": "0xAE"
   },
   "say": "Spectrometer: exposure {exposure}, param2 {param2}",
   "device": "ba8c:1688",
   "fields": [
    {
     "name": "exposure",
     "offset": 0,
     "length": 4,
     "type": "u32le",
     "add": 1,
     "scale": 1.6e-05,
     "unit": "s"
    },
    {
     "name": "param2",
     "offset": 4,
     "length": 4,
     "type": "u32le"
    }
   ]
  },
  {
   "name": "BaySpec: start exposure",
   "usb": {
    "bmRequestType": "0x40",
    "bRequest": "0xAA",
    "wValue": "0xFFFF"
   },
   "say": "Spectrometer: START exposure",
   "device": "ba8c:1688"
  },
  {
   "name": "BaySpec: end exposure",
   "usb": {
    "bmRequestType": "0x40",
    "bRequest": "0xAA",
    "wValue": "0x0000"
   },
   "say": "Spectrometer: end of exposure",
   "device": "ba8c:1688"
  },
  {
   "name": "BaySpec: spectrum",
   "device": "ba8c:1688",
   "ep": 2,
   "dir": "from-instrument",
   "hex": "*",
   "say": "Spectrometer: frame of {pixels} bytes (big-endian 16-bit pixels, reverse order: pixel p = 2057 − index)",
   "fields": [
    {
     "name": "pixels",
     "offset": 0,
     "length": 0,
     "type": "hex",
     "values": {}
    }
   ]
  },
  {
   "name": "I/O: laser emission on",
   "device": "067b:2303",
   "dir": "to-instrument",
   "text": "^IO L 09\\n$",
   "say": "I/O board: line 09 low = LASER EMISSION ON (532 nm; only when armed)"
  },
  {
   "name": "I/O: laser emission off",
   "device": "067b:2303",
   "dir": "to-instrument",
   "text": "^IO H 09\\n$",
   "say": "I/O board: line 09 high = laser emission off"
  },
  {
   "name": "I/O: set line",
   "device": "067b:2303",
   "dir": "to-instrument",
   "text": "^IO ([HL]) ([0-9a-fA-F]{2})\\n$",
   "say": "I/O board: line {line} {level}",
   "fields": [
    {
     "name": "level",
     "group": 1,
     "type": "text",
     "values": {
      "H": "high (off)",
      "L": "low (on; power lines bring up a USB device)"
     }
    },
    {
     "name": "line",
     "group": 2,
     "type": "text",
     "values": {
      "0a": "0a (inner hub power)",
      "0c": "0c (spectrometer #1 power)",
      "0d": "0d (spectrometer #2 power)",
      "07": "07 (laser driver power, 1064 nm)",
      "08": "08 (532 nm laser supply?)",
      "0b": "0b (1064/532 switching)",
      "0e": "0e (beam path)",
      "0f": "0f (beam path)"
     }
    }
   ]
  },
  {
   "name": "I/O: TEC enable",
   "device": "067b:2303",
   "dir": "to-instrument",
   "text": "^TECE\\n$",
   "say": "I/O board: TEC enable (TECE)"
  },
  {
   "name": "I/O: VOL query",
   "device": "067b:2303",
   "dir": "to-instrument",
   "text": "^VOL (\\d+)\\n$",
   "say": "I/O board: read analogue input {ch} (polled every 2 s)",
   "fields": [
    {
     "name": "ch",
     "group": 1,
     "type": "text"
    }
   ]
  },
  {
   "name": "I/O: USB",
   "device": "067b:2303",
   "dir": "to-instrument",
   "text": "^USB\\n$",
   "say": "I/O board: USB (first step of the vendor shutdown)"
  },
  {
   "name": "I/O: OFF",
   "device": "067b:2303",
   "dir": "to-instrument",
   "text": "^OFF\\n$",
   "say": "I/O board: OFF (shuts the instrument down)"
  },
  {
   "name": "I/O: OK",
   "device": "067b:2303",
   "dir": "from-instrument",
   "text": "^OK\\n$",
   "say": "I/O board: OK"
  },
  {
   "name": "I/O: VOL reading",
   "device": "067b:2303",
   "dir": "from-instrument",
   "text": "^VOL:([0-9.]+)\\n(OK\\n)?$",
   "say": "I/O board: analogue reading {v}",
   "fields": [
    {
     "name": "v",
     "group": 1,
     "type": "float"
    }
   ]
  },
  {
   "name": "I/O: USB reply",
   "device": "067b:2303",
   "dir": "from-instrument",
   "text": "^USB:(\\d+)\\n$",
   "say": "I/O board: USB:{v}",
   "fields": [
    {
     "name": "v",
     "group": 1,
     "type": "text"
    }
   ]
  },
  {
