#!/bin/sh
# LibreTap's .deb: let the installing user capture network traffic (LibreTap's Ethernet recording) without root.
# This is what answering "Yes" to Wireshark's "Should non-superusers be able to capture packets?" does: a
# "wireshark" group, dumpcap (Wireshark's capture helper) runnable by that group with the capture capabilities,
# and the installing user in the group. Undo: sudo dpkg-reconfigure wireshark-common (answer No) and
# sudo gpasswd -d <user> wireshark.
set -e

if [ "$1" = "configure" ]; then
    # 1. Wireshark's own way, remembered for its upgrades
    if command -v debconf-set-selections >/dev/null 2>&1; then
        echo "wireshark-common wireshark-common/install-setuid boolean true" | debconf-set-selections || true
    fi
    if command -v dpkg-reconfigure >/dev/null 2>&1; then
        DEBIAN_FRONTEND=noninteractive dpkg-reconfigure -f noninteractive wireshark-common >/dev/null 2>&1 || true
    fi
    # 2. the same by hand if that could not run (dpkg-reconfigure refuses while dpkg is busy on some systems)
    if [ -x /usr/bin/dumpcap ]; then
        getent group wireshark >/dev/null 2>&1 || addgroup --quiet --system wireshark || true
        if ! dpkg-statoverride --list /usr/bin/dumpcap >/dev/null 2>&1; then
            dpkg-statoverride --update --add root wireshark 0754 /usr/bin/dumpcap || true
        fi
        if command -v setcap >/dev/null 2>&1; then
            setcap cap_net_raw,cap_net_admin=eip /usr/bin/dumpcap || chmod u+s /usr/bin/dumpcap || true
        else
            chmod u+s /usr/bin/dumpcap || true
        fi
    fi
    # 3. the user who installed LibreTap (sudo or pkexec) into the group; LibreTap uses `sg wireshark` until the
    #    next login, so no logout is needed
    user="${SUDO_USER:-}"
    if [ -z "$user" ] && [ -n "${PKEXEC_UID:-}" ]; then
        user=$(getent passwd "$PKEXEC_UID" | cut -d: -f1)
    fi
    if [ -n "$user" ] && [ "$user" != "root" ] && getent passwd "$user" >/dev/null 2>&1 && getent group wireshark >/dev/null 2>&1; then
        usermod -aG wireshark "$user" || true
    fi
fi

exit 0
