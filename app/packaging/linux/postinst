#!/bin/sh
# LibreTap's .deb: let the installing user capture network traffic (LibreTap's Ethernet recording) without root.
# The work is in /usr/libexec/libretap/setup-capture (LibreTap runs the same through pkexec when capture is not set
# up yet): Wireshark's "non-superusers may capture" setting, and the installing user (sudo or pkexec) in the
# wireshark group. Undo: sudo dpkg-reconfigure wireshark-common (choose No) and sudo gpasswd -d <user> wireshark.
set -e

if [ "$1" = "configure" ] && [ -x /usr/libexec/libretap/setup-capture ]; then
    # dpkg is busy here: no apt-get inside (Wireshark is a dependency, so dumpcap is already installed)
    /usr/libexec/libretap/setup-capture || true
fi

exit 0
