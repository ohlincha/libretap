#include <windows.h>
#include "resource.h"

IDI_TICK ICON "tick.ico"


VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,5,0,0
PRODUCTVERSION 0,5,0,0
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "LibreTap"
      VALUE "FileDescription", "Tick - screen and serial recorder for LibreTap"
      VALUE "FileVersion", "0.5.0"
      VALUE "InternalName", "Tick"
      VALUE "LegalCopyright", "Part of LibreTap"
      VALUE "OriginalFilename", "Tick.exe"
      VALUE "ProductName", "LibreTap"
      VALUE "ProductVersion", "0.5.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_ADV DIALOG 0, 0, 260, 278
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tick - Settings"
FONT 8, "MS Sans Serif"
BEGIN
  LTEXT "Take a screenshot every", -1, 8, 10, 90, 8
  EDITTEXT IDC_INTERVAL, 100, 8, 36, 12, ES_NUMBER
  LTEXT "milliseconds", -1, 140, 10, 60, 8
  LTEXT "Store a full picture every", -1, 8, 26, 90, 8
  EDITTEXT IDC_FULLEVERY, 100, 24, 36, 12, ES_NUMBER
  LTEXT "stored screenshots", -1, 140, 26, 80, 8
  AUTOCHECKBOX "Show the mouse pointer in screenshots", IDC_CURSOR, 8, 42, 240, 10
  AUTOCHECKBOX "Record the title of the active window", IDC_TITLES, 8, 54, 240, 10
  AUTOCHECKBOX "Leave Tick's own window out of screenshots", IDC_MASK, 8, 66, 240, 10
  AUTOCHECKBOX "Keep Tick on top of other windows", IDC_TOPMOST, 8, 78, 240, 10
  AUTOCHECKBOX "Screenshots show only the vendor program's windows (rest black)", IDC_PROGONLY, 8, 90, 244, 10
  PUSHBUTTON "Pick window", IDC_PICKWIN, 20, 102, 70, 14
  AUTOCHECKBOX "Copy the started program's settings files (*.ini, *.cfg...)", IDC_COPYSET, 8, 122, 240, 10
  LTEXT "Record what the program uses:", -1, 8, 136, 110, 8
  AUTOCHECKBOX "serial ports", IDC_RECSER, 116, 135, 50, 10
  AUTOCHECKBOX "network", IDC_RECNET, 168, 135, 40, 10
  AUTOCHECKBOX "USB", IDC_RECUSB, 212, 135, 40, 10
  LTEXT "Sessions folder (empty: TickSessions next to Tick.exe):", -1, 8, 154, 240, 8
  EDITTEXT IDC_DIR, 8, 164, 244, 12, ES_AUTOHSCROLL
  PUSHBUTTON "Open sessions folder", IDC_OPENDIR, 8, 182, 100, 14
  LTEXT "", IDC_INFO, 8, 204, 244, 48
  DEFPUSHBUTTON "OK", IDOK, 146, 258, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 202, 258, 50, 14
END


IDD_PROGRAMS DIALOG 0, 0, 300, 206
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Start a program"
FONT 8, "MS Sans Serif"
BEGIN
  LTEXT "Which program talks to the instrument? Choose it, Browse for it, or Pick its window. A program or shortcut can also be dropped onto Tick.", -1, 8, 6, 284, 18
  LISTBOX IDC_PLIST, 8, 28, 284, 134, LBS_NOTIFY | WS_VSCROLL | WS_HSCROLL | WS_BORDER | WS_TABSTOP
  LTEXT "", IDC_PDETAIL, 8, 166, 284, 10, SS_NOPREFIX
  DEFPUSHBUTTON "Start", IDOK, 8, 184, 50, 14
  PUSHBUTTON "Browse...", IDC_PBROWSE, 64, 184, 50, 14
  PUSHBUTTON "Pick window", IDC_PPICK, 120, 184, 56, 14
  PUSHBUTTON "Cancel", IDCANCEL, 242, 184, 50, 14
END
